{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User profile with role-based access control information.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Manager", "Staff"] },
        "locationIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "name", "role"]
    },
    "products": {
      "title": "Product",
      "description": "Inventory product details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "unit": { "type": "string" },
        "minStockLevel": { "type": "number" },
        "price": { "type": "number" },
        "costPrice": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "sku", "category", "unit", "minStockLevel", "price"]
    },
    "locations": {
      "title": "Location",
      "description": "Storage or retail location.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["id", "name", "address"]
    },
    "inventory": {
      "title": "Inventory Item",
      "description": "Stock level for a product at a specific location.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "locationId": { "type": "string" },
        "quantity": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "locationId", "quantity"]
    },
    "sales": {
      "title": "Sale",
      "description": "Sale transaction record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "locationId": { "type": "string" },
        "quantity": { "type": "number" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["Completed", "Pending", "Cancelled"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "locationId", "quantity", "totalPrice", "timestamp"]
    },
    "purchases": {
      "title": "Purchase",
      "description": "Inventory purchase record from supplier.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "locationId": { "type": "string" },
        "supplierId": { "type": "string" },
        "quantity": { "type": "number" },
        "costPrice": { "type": "number" },
        "totalCost": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "locationId", "supplierId", "quantity", "costPrice", "totalCost", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profiles for auth and RBAC."
    },
    "/products/{productId}": {
      "schema": "products",
      "description": "Product catalog."
    },
    "/locations/{locationId}": {
      "schema": "locations",
      "description": "Business locations."
    },
    "/inventory/{inventoryId}": {
      "schema": "inventory",
      "description": "Stock levels."
    },
    "/sales/{saleId}": {
      "schema": "sales",
      "description": "Sales records."
    },
    "/purchases/{purchaseId}": {
      "schema": "purchases",
      "description": "Purchase history."
    }
  }
}
